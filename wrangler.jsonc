
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earthquake-monitoring-system",
  "main": "src/index.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "earthquake-monitor-db",
      "database_id": "bbb77179-d356-4ea6-a2af-44b7e823e44d"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "RAW_DATA",
      "id": "165946d0893541aca1bfe4b2559c942f"
    }
  ],

  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  }
}
